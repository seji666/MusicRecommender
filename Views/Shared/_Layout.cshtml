<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Music Recommender</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">🎵 Music Recommender</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Топ класация</a>
                <a class="nav-link" asp-controller="Tracks" asp-action="Search">Търсене</a>
                <a class="nav-link" asp-controller="Tracks" asp-action="Favorites">Любими</a>
                <a class="nav-link" asp-controller="Recommendations" asp-action="Index">AI препоръки</a>
                <a class="nav-link" asp-controller="Recommendations" asp-action="History">История</a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success">@msg</div>
        }
        @RenderBody()
    </main>

    <script>
        
        document.addEventListener('submit', async e => {
            const f = e.target;
            if (!f.classList.contains('ajax-add')) return;
            e.preventDefault();
            const btn = f.querySelector('button');
            btn.disabled = true;
            try {
                const r = await fetch(f.action, {
                    method: 'POST',
                    body: new FormData(f),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                btn.textContent = r.ok ? 'Добавена ✓' : 'Грешка';
                if (!r.ok) btn.disabled = false;
            } catch { btn.textContent = 'Грешка'; btn.disabled = false; }
        });
    </script>
</body>
</html>
