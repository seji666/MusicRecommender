@model TrackListViewModel
@{
    ViewData["Title"] = "Топ класация";
}
<div class="p-4 mb-4 bg-light rounded-3">
    <h1 class="h3">🎧 Интелигентен препоръчител на музика</h1>
    <p class="mb-0">Разглеждайте най-слушаните песни в Deezer, запазвайте любими и получавайте персонални препоръки от изкуствен интелект.</p>
</div>

<h2 class="h4 mb-3">Топ песни в момента</h2>
@if (Model.Error != null)
{
    <div class="alert alert-warning">@Model.Error</div>
}
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
    @foreach (var t in Model.Tracks)
    {
        <div class="col">
            <partial name="_TrackCard" model="t" view-data='new ViewDataDictionary(ViewData) { { "ShowAdd", true } }' />
        </div>
    }
</div>
