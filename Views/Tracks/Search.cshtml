@model TrackListViewModel
@{
    ViewData["Title"] = "Търсене";
}
<h2 class="h4 mb-3">🔍 Търсене в Deezer</h2>
<form method="get" asp-action="Search" class="row g-2 mb-4">
    <div class="col-md-8">
        <input type="text" name="q" value="@Model.Query" class="form-control" placeholder="Изпълнител, песен или албум..." />
    </div>
    <div class="col-auto"><button class="btn btn-primary">Търси</button></div>
</form>

@if (Model.Error != null)
{
    <div class="alert alert-warning">@Model.Error</div>
}
else if (!string.IsNullOrWhiteSpace(Model.Query) && Model.Tracks.Count == 0)
{
    <div class="alert alert-info">Няма намерени резултати.</div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
    @foreach (var t in Model.Tracks)
    {
        <div class="col">
            <partial name="_TrackCard" model="t" view-data='new ViewDataDictionary(ViewData) { { "ShowAdd", true } }' />
        </div>
    }
</div>
